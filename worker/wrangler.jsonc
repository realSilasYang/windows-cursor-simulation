{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "windows-cursor-simulation-stats",
  "main": "src/index.js",
  "compatibility_date": "2026-08-09",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAGE_VIEW_COUNTER",
        "class_name": "PageViewCounter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PageViewCounter"]
    }
  ],
  "vars": {
    "INITIAL_TOTAL_PAGE_VIEWS": "18",
    "ALLOWED_ORIGINS": "https://realsilasyang.github.io,http://127.0.0.1:8127,http://localhost:8127,http://127.0.0.1:8128,http://localhost:8128"
  }
}
